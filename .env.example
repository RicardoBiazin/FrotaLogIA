# Copie para .env e ajuste. Todas as variáveis são opcionais.

# Porta HTTP/WebSocket
PORT=3000

# Interface de rede. Vazio: 127.0.0.1 no modo aberto (só esta máquina) e 0.0.0.0 quando há chave.
HOST=

# Clientes, chaves (hash) e CDs. Crie com: npm run cliente -- <id> "<nome>" [--demo]
CLIENTES_FILE=data/clientes.json

# Sem clientes.json: chave do cliente "demo" (header x-api-key e tela de acesso).
# Vazio = acesso aberto, só para desenvolvimento.
API_KEY=

# Simulador de frota (true/false). Desligue quando ligar fontes reais.
SIMULATE=true
# Cliente que recebe os dados simulados
SIM_CLIENTE=demo
# Fator de aceleração do tempo simulado (1 = velocidade real; 5 = 5x mais rápido)
SIM_SPEEDUP=5

# Servidor OSRM usado pelo simulador para obter o traçado real das ruas.
# O servidor público é só para demonstração; use uma instância própria em produção.
OSRM_URL=https://router.project-osrm.org

# Estilo de mapa MapLibre (URL de style.json). Vazio = OpenFreeMap Positron (vetorial, sem chave).
# Verifique os termos de uso do provedor antes de ir para produção.
MAP_STYLE_URL=
# Fonte dos rótulos dos ativos; precisa existir nos glyphs do estilo. Vazio = Noto Sans Bold.
MAP_LABEL_FONT=

# Segundos sem receber posição até o ativo ficar "sem sinal"
OFFLINE_AFTER_S=60
# Pontos de rastro mantidos por ativo
TRAIL_MAX=300
# Intervalo (ms) de agrupamento das atualizações enviadas aos navegadores
BATCH_MS=250
# Máximo de ativos distintos, somando todos os clientes (IDs novos acima disso são recusados)
MAX_ASSETS=10000
